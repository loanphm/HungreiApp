<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Practice2"
    android:stretchColumns="*"
    android:background="#D5AEC8">

   <TableRow
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:background="@color/white"
       android:padding="10dp">

       <TextView
           android:layout_width="100dp"
           android:layout_height="wrap_content"
           android:background="@color/white"
           android:text="@string/txtdichvu"
           android:textColor="@color/black"
           android:gravity="center"
           android:layout_gravity="center"
           android:textStyle="bold"
           android:textSize="25sp" />

       <Button
           android:layout_width="140dp"
           android:layout_height="60dp"
           android:text="@string/btnthoat"
           android:textSize="23sp"
           android:textColor="@color/white"
           android:textStyle="bold"
           android:layout_gravity="center"
           android:backgroundTint="#D5AEC8"/>

   </TableRow>

    <TableRow>
        <ImageButton
            android:layout_marginTop="20dp"
            android:src="@drawable/washing"
            android:layout_width="70dp"
            android:layout_height="90dp"
            android:scaleType="fitCenter"
            android:background="#D5AEC8" />

        <ImageButton
            android:layout_marginTop="20dp"
            android:src="@drawable/hotel"
            android:layout_width="70dp"
            android:layout_height="90dp"
            android:scaleType="fitCenter"
            android:background="#D5AEC8" />
    </TableRow>

    <TableRow>
        <TextView
            android:layout_marginTop="15dp"
            android:layout_width="70dp"
            android:layout_height="80dp"
            android:text="@string/txtgiat"
            android:textSize="23sp"
            android:layout_gravity="center"
            android:textColor="@color/white"/>

        <TextView
            android:layout_marginTop="15dp"
            android:layout_width="70dp"
            android:layout_height="80dp"
            android:text="@string/txtkhachsan"
            android:textSize="23sp"
            android:layout_gravity="center"
            android:textColor="@color/white"/>

    </TableRow>

    <TableRow>
        <ImageButton
            android:src="@drawable/taxi"
            android:layout_width="70dp"
            android:layout_height="90dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:background="#D5AEC8" />

        <ImageButton
            android:adjustViewBounds="true"
            android:src="@drawable/fastfood"
            android:layout_width="70dp"
            android:layout_height="90dp"
            android:scaleType="fitCenter"
            android:background="#D5AEC8" />
    </TableRow>
    <TableRow>
        <TextView
            android:layout_marginTop="15dp"
            android:layout_width="70dp"
            android:layout_height="80dp"
            android:text="@string/txttaxi"
            android:textSize="23sp"
            android:layout_gravity="center"
            android:textColor="@color/white"/>

        <TextView
            android:layout_marginTop="15dp"
            android:layout_width="70dp"
            android:layout_height="80dp"
            android:text="@string/txtthucannhanh"
            android:textSize="23sp"
            android:layout_gravity="center"
            android:textColor="@color/white"/>

    </TableRow>

    <TableRow>

        <ImageButton
            android:src="@drawable/delivery"
            android:layout_width="70dp"
            android:layout_height="90dp"
            android:scaleType="fitCenter"
            android:layout_column="1"
            android:background="#D5AEC8" />
    </TableRow>

    <TableRow>
        <TextView
            android:layout_column="1"
            android:layout_marginTop="15dp"
            android:layout_width="70dp"
            android:layout_height="80dp"
            android:text="@string/txtvanchuyen"
            android:textSize="23sp"
            android:layout_gravity="center"
            android:textColor="@color/white"/>
    </TableRow>

</TableLayout>